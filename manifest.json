{
    "manifest_version": 3,
    "name": "FasihSM-Guard",
    "version": "1.8.1",
    "description": "sesuai judul",
    "permissions": [
        "cookies",
        "tabs",
        "scripting",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "https://bps.go.id/*",
        "http://bps.go.id/*",
        "https://*.bps.go.id/*",
        "http://*.bps.go.id/*",
        "http://127.0.0.1:5000/*",
        "http://localhost:5000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Guard Session",
        "default_icon": "logo.png"
    },
    "icons": {
        "16": "logo.png",
        "48": "logo.png",
        "128": "logo.png"
    },
    "content_scripts": [
        {
            "matches": [
                "http://127.0.0.1/*",
                "http://localhost/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://fasih-sm.bps.go.id/*"
            ],
            "js": [
                "keepalive.js"
            ],
            "run_at": "document_idle"
        }
    ]
}